      "source": [
        "# #6 Calculate distance from a specific latitude and longitude\n",
        "\n",
        "import numpy as np\n",
        "\n",
        "# Set reference location\n",
        "reference_lat = 30.0\n",
        "reference_long = -83.7\n",
        "\n",
        "# Haversine distance function\n",
        "def calculate_distance(lat1, lon1, lat2, lon2):\n",
        "    earth_radius = 3958.8  # Earth radius in miles\n",
        "\n",
        "    lat1 = np.radians(lat1)\n",
        "    lon1 = np.radians(lon1)\n",
        "    lat2 = np.radians(lat2)\n",
        "    lon2 = np.radians(lon2)\n",
        "\n",
        "    dlat = lat2 - lat1\n",
        "    dlon = lon2 - lon1\n",
        "\n",
        "    a = (\n",
        "        np.sin(dlat / 2) ** 2\n",
        "        + np.cos(lat1) * np.cos(lat2) * np.sin(dlon / 2) ** 2\n",
        "    )\n",
        "\n",
        "    c = 2 * np.arctan2(np.sqrt(a), np.sqrt(1 - a))\n",
        "\n",
        "    return earth_radius * c\n",
        "\n",
        "\n",
        "# Calculate distance for every store\n",
        "store_results[\"miles_from_landfall\"] = calculate_distance(\n",
        "    reference_lat,\n",
        "    reference_long,\n",
        "    store_results[\"latitude\"].astype(float),\n",
        "    store_results[\"longitude\"].astype(float)\n",
        ")\n",
        "\n",
        "# Display results\n",
        "display(store_results.round(2))"
