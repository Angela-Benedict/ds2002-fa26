      "cell_type": "code",
      "source": [
        "#2Nothing needs to be transfered\n",
        "landfall = pd.Timestamp(\"2024-9-26\")\n",
        "\n",
        "baseline = daily_category[\n",
        "    (daily_category[\"date\"] >= \"2024-9-08\") &\n",
        "    (daily_category[\"date\"] <= \"2024-9-15\")\n",
        "]\n",
        "surge = daily_category[\n",
        "    (daily_category[\"date\"] >= \"2024-9-19\") &\n",
        "    (daily_category[\"date\"] <= \"2024-9-25\")\n",
        "]\n",
        "\n",
        "baseline_avg = baseline.groupby(\"category_clean\")[\"quantity\"].mean()\n",
        "surge_avg = surge.groupby(\"category_clean\")[\"quantity\"].mean()\n",
        "surge_multiple = surge_avg / baseline_avg\n",
        "\n",
        "percent_increase = (surge_multiple - 1) * 100\n",
        "\n",
        "q1_results = pd.DataFrame({\n",
        "    \"baseline_avg\": baseline_avg,\n",
        "    \"pre_landfall_avg\": surge_avg,\n",
        "    \"surge_multiple\": surge_multiple,\n",
        "    \"percent_increase\": percent_increase\n",
        "}).sort_values(\"percent_increase\", ascending=False)\n",
        "\n",
        "daily_wide=daily_category.pivot(\n",
        "    index='date',\n",
        "    columns='category_clean',\n",
        "    values = 'quantity'\n",
        ")\n",
        "\n",
        "q1_results.round(2)"
      ],
