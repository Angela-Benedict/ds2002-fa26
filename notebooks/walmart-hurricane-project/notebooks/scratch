      "source": [
        "#1 cleaned data:\n",
        "import pandas as pd\n",
        "\n",
        "sales = pd.read_csv(\n",
        "    \"ds2002-fa26/notebooks/walmart-hurricane-project/data/walmart_transactions.csv\"\n",
        ")\n",
        "q1 = sales.drop_duplicates().copy()\n",
        "\n",
        "q1[\"timestamp\"] = pd.to_datetime(q1[\"timestamp\"], format=\"mixed\", errors=\"coerce\")\n",
        "q1[\"date\"] = q1[\"timestamp\"].dt.normalize()\n",
        "q1[\"quantity\"] = pd.to_numeric(q1[\"quantity\"], errors= \"coerce\")\n",
        "\n",
        "q1['category_clean'] = (\n",
        "    q1[\"category\"]\n",
        "    .astype(str)\n",
        "    .str.strip()\n",
        "    .str.lower()\n",
        ")\n",
        "\n",
        "category_map = {\n",
        "    \"emergency\": \"Emergency Supplies\",\n",
        "    'emergency supplies': \"Emergency Supplies\",\n",
        "    \"groceries\": \"Groceries\",\n",
        "    \"grocery\": \"Groceries\",\n",
        "    \"electronics\": \"Electronics\",\n",
        "    \"household\": \"Household\",\n",
        "    \"household essentials\": \"Household\",\n",
        "    \"baby\": \"Baby Products\",\n",
        "    \"baby products\": \"Baby Products\",\n",
        "    \"breakfast\": \"Breakfast Foods\",\n",
        "    \"breakfast foods\":\"Breakfast Foods\",\n",
        "    \"health\":\"Health\",\n",
        "    \"health & wellness\":\"Health\",\n",
        "    \"alcohol\":\"Alcohol\",\n",
        "    \"alcoholic beverages\":\"Alcohol\",\n",
        "    'games & entertainment':\"Entertainment\",\n",
        "    \"entertainment\":\"Entertainment\",\n",
        "    \"snacks\":\"Snacks\"\n",
        "}\n",
        "q1[\"category_clean\"] = q1[\"category_clean\"].map(category_map)\n",
        "\n",
        "# Clean store IDs - NEEDS TO BE ADDED TO Q1\n",
        "q1[\"store_id\"] = (\n",
        "    q1[\"store_id\"]\n",
        "    .astype(str)\n",
        "    .str.strip()\n",
        "    .str.upper()\n",
        "    .str.replace(\"-\", \"\", regex=False)\n",
        "    .str.replace(\"_\", \"\", regex=False)\n",
        ")\n",
        "\n",
        "daily_category = (\n",
        "    q1.groupby([\"date\", \"category_clean\"]) [\"quantity\"]\n",
        "    .sum()\n",
        "    .reset_index()\n",
        ")"
      ],
