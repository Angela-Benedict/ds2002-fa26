        "#3 Calculate daily sales by store: NEEDS TO BE ADDED TO Q3\n",
        "daily_store = (\n",
        "    q1.groupby([\"date\", \"store_id\"])[\"quantity\"]\n",
        "    .sum()\n",
        "    .reset_index()\n",
        ")\n",
        "\n",
        "# Separate baseline and surge periods\n",
        "baseline_store = daily_store[\n",
        "    (daily_store[\"date\"] >= \"2024-09-08\") &\n",
        "    (daily_store[\"date\"] <= \"2024-09-15\")\n",
        "]\n",
        "\n",
        "surge_store = daily_store[\n",
        "    (daily_store[\"date\"] >= \"2024-09-19\") &\n",
        "    (daily_store[\"date\"] <= \"2024-09-25\")\n",
        "]\n",
        "\n",
        "# Calculate average daily sales for each store\n",
        "baseline_avg = baseline_store.groupby(\"store_id\")[\"quantity\"].mean()\n",
        "surge_avg = surge_store.groupby(\"store_id\")[\"quantity\"].mean()\n",
        "\n",
        "# Calculate surge multiple\n",
        "surge_multiple = surge_avg / baseline_avg\n",
        "percent_increase = (surge_multiple - 1) * 100\n",
        "\n",
        "# Create store results\n",
        "store_results = pd.DataFrame({\n",
        "    \"baseline_avg\": baseline_avg,\n",
        "    \"pre_landfall_avg\": surge_avg,\n",
        "    \"surge_multiple\": surge_multiple,\n",
        "    \"percent_increase\": percent_increase\n",
        "}).sort_values(\"percent_increase\", ascending=False)\n",
        "\n",
        "store_results = store_results.reset_index()\n",
        "\n",
        "# Calculate total transactions/quantity for each store\n",
        "total_store_sales = (\n",
        "    q1.groupby(\"store_id\")[\"quantity\"]\n",
        "    .sum()\n",
        "    .reset_index(name=\"total_transactions\")\n",
        ")\n",
        "\n",
        "# Display every store's surge multiple\n",
        "display(store_results.round(2))"
      ],
